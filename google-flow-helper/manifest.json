{
  "manifest_version": 3,
  "name": "豆包调用 Google Flow",
  "version": "1.0.0",
  "description": "一键调用 Google Flow 生成图片/视频：自动填入提示词、点击生成、结果自动下载",
  "permissions": ["activeTab", "scripting", "storage", "downloads", "tabs", "notifications", "sidePanel"],
  "host_permissions": [
    "https://labs.google/*",
    "https://flow.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Google Flow 助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/fx/tools/flow*",
        "https://labs.google/flow*",
        "https://flow.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
